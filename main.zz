bool is_prime(int n) {
    if (n < 2) { return false; }
    if (n == 2) { return true; }
    if (n - (n / 2) * 2 == 0) { return false; } 

    int i = 3;
    loop {
        if (i * i > n) { break; }
        if (n - (n / i) * i == 0) { return false; }
        i = i + 2;
    }
    return true;
}

void fizzbuzz(int limit) {
    for (int i = 1; i <= limit; i = i + 1) {
        if (i - (i / 15) * 15 == 0) {
            print "FizzBuzz";
        } else if (i - (i / 3) * 3 == 0) {
            print "Fizz";
        } else if (i - (i / 5) * 5 == 0) {
            print "Buzz";
        } else {
            print i;
        }
    }
}

void entryf() {
    print "=== FizzBuzz 1..20 ===";
    fizzbuzz(20);
    print "";

    print "=== Primes below 30 ===";
    int n = 30;
    int count = 0;
    for (int i = 2; i < n; i = i + 1) {
        if (is_prime(i)) {
            print i;
            count = count + 1;
        }
    }
    print "Total primes: " + count;
}
